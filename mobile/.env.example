# Copy these into mobile/.env.local (which is never committed) and fill them in.

# The Mise server's recipe endpoint, for "Import with AI" and Sous.
EXPO_PUBLIC_AI_URL=

# Where "Send feedback" emails go.
EXPO_PUBLIC_FEEDBACK_EMAIL=

# Online accounts (Supabase). Leave empty to use demo accounts kept on the phone.
# Supabase dashboard → Project Settings → API: the Project URL and the "anon public" key.
# The anon key is meant to be public; never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
