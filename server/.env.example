# Copy to .env.local (never commit it) and fill in.
ANTHROPIC_API_KEY=
# Optional: shared rate limits across server instances (Upstash Redis from the Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional limits (requests per day)
AI_LIMIT_PER_DEVICE=25
AI_LIMIT_PER_IP=60
AI_DAILY_LIMIT=500
ALLOWED_ORIGINS=https://jabu14.github.io
